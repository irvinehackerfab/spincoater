{
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "cargo": {
          "allTargets": false,
          "target": "xtensa-esp32-none-elf",
          "extraEnv": {
            "RUSTUP_TOOLCHAIN": "esp",
          },
        },
        "server": {
          "extraEnv": {
            "RUSTUP_TOOLCHAIN": "stable",
          },
        },
        "check": {
          // "extraEnv": {
          //   "RUSTUP_TOOLCHAIN": "esp",
          // },
          // Temporary fix for https://github.com/rust-lang/rust-analyzer/issues/22371
          // Remove when ESP toolchain updates
          "overrideCommand": [
            "cargo",
            "check",
            "--workspace",
            "--message-format=json",
            "--target",
            "xtensa-esp32-none-elf",
          ],
        },
      },
    },
  },
}
